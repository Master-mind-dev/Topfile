{
  "name": "ownly-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"node server.js\" \"vite\"",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc && vite build",
    "build:electron": "vite build && electron-builder -w",
    "postinstall": "npm run build",
    "preview": "vite preview",
    "start": "node server.js"
  },
  "build": {
    "appId": "com.ownly.app",
    "productName": "Ownly",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {
    "@cyntler/react-doc-viewer": "^1.17.1",
    "axios": "^1.18.1",
    "bcrypt": "^5.1.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase": "^11.4.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "nodemailer": "^10.0.13",
    "pg": "^8.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "wait-on": "^9.5.1"
  }
}
